    <language>en-uk</language>
    <description><![CDATA[<p>The source-to-sea audio companion for the Great Ouse.</p><p>For 150 miles, the Great Ouse meanders through Middle England and you can follow its route by walking the Ouse Valley Way.</p><p>I've met all sorts of people on the way from rangers to river rinsers. You can listen to the conversations we had along the way.</p><p>More details are available including a map on the <a href='https://greatouseways.info'>Great Ouse Ways website</a></p>]]></description>
    <content:encoded><![CDATA[<p>A source-to-sea audio companion for for the Great Ouse.</p><p>For 150 miles, the Great Ouse meanders through Middle England and you can follow its route by walking the Ouse Valley Way.</p><p>I've met all sorts of people on the way from rangers to river rinsers. You can listen to the conversations we had along the way.</p><p>More details are available including a map on the <a href='https://greatouseways.info'>Great Ouse Ways website</a></p>]]></content:encoded>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <itunes:category text="Leisure"/>
    <itunes:explicit>false</itunes:explicit>
    <itunes:type>serial</itunes:type>
    <spotify:countryOfOrigin>uk</spotify:countryOfOrigin>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- for item in site.data.recordings %}
    {%- if item[1].draft == "false" %}
      <item>
        <title>{{ item[1].heading | xml_escape }}</title>
        <description>{{ item[1].about | xml_escape }}</description>
        <pubDate>{{ item[1].date | date_to_rfc822 }}</pubDate>
        <itunes:image href='{{ item[1].pod_image | prepend: site.baseurl | prepend: site.url }}' />
        <link>{{ site.url }}{{ site.baseurl }}/audio.html?chat={{ item[0] }}</link>
        <itunes:explicit>false</itunes:explicit>
        <itunes:summary>{{ item[1].about | xml_escape }}&lt;br&gt;&lt;a href=&apos;https://greatouseways.info/audio.html?chat={{ item[0] }}&apos; target=&apos;blank&apos;&gt;location on map&lt;/a&gt;</itunes:summary>
        <itunes:author>Howard Osborne</itunes:author>
        <content:encoded>{{ item[1].about | xml_escape }}&lt;br&gt;&lt;a href=&apos;https://greatouseways.info/audio.html?chat={{ item[0] }}&apos; target=&apos;blank&apos;&gt;location on map&lt;/a&gt;</content:encoded>
        <enclosure url='{{ item[1].filepath | prepend: site.baseurl | prepend: site.url }}' type='audio/mpeg' length='{{ item[1].size }}'/>
        <guid isPermaLink="true">{{ item[1].filepath | prepend: site.baseurl | prepend: site.url }}</guid>
      </item>
    {% endif -%}
    {% endfor -%}
